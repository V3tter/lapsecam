#!/usr/bin/env bash
# lapsecam — terminal launcher for LapseCam
APP_DIR="${LAPSECAM_HOME:-$HOME/LapseCam}"

# -d / --detach: launch fully detached (terminal can be closed immediately).
if [[ "$1" == "-d" || "$1" == "--detach" ]]; then
  shift
  setsid -f "$0" "$@"
  exit 0
fi

# Prefer the tray-enabled venv created by the installer, if present.
if [[ -x "$APP_DIR/.venv/bin/python" ]]; then
  exec "$APP_DIR/.venv/bin/python" "$APP_DIR/TimelapseRecorder.py" "$@"
else
  exec python3 "$APP_DIR/TimelapseRecorder.py" "$@"
fi
